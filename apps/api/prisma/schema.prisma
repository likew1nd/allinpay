// 系统设置：键值开关，值存字符串（mfa.enabled 等），默认都是关
model SystemSetting {
  key       String   @id @map("setting_key")
  value     String   @map("setting_value")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

// 用户验证器：TOTP 密钥加密存放，验证通过后才生效；lastUsedStep 防止同一个验证码重复使用
model UserTotp {
  id              String    @id
  userId          String    @unique @map("user_id")
  secretEncrypted String    @map("secret_encrypted")
  verified        Boolean   @default(false)
  lastUsedStep    Int?      @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  verifiedAt      DateTime? @map("verified_at")

  @@map("user_totp")
}

// 收款人白名单：转账只能转给这里登记的收款人，请求里不能直接传任意收款账号
model TransferPool {
  id String @id
  name String
  enabled Boolean @default(true)
  payees Payee[]
  createdAt DateTime @default(now()) @map("created_at")
  @@map("transfer_pool")
}

model Payee {
  poolId String? @map("pool_id")
  pool TransferPool? @relation(fields: [poolId], references: [id], onDelete: Restrict)
  dailyLimit Decimal? @map("daily_limit") @db.Decimal(20, 2)
  totalLimit Decimal? @map("total_limit") @db.Decimal(20, 2)
  id               String            @id
  name             String
  accountEncrypted String            @map("account_encrypted") @db.Text
  accountMasked    String            @map("account_masked")
  status           String            @default("ACTIVE")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  rules            TransferRule[]
  requests         TransferRequest[]

  @@index([status])
  @@map("payee")
}

// 转账规则通过 enabled 开关控制；mode 仅兼容历史存储，新规则固定 AUTO。
model TransferRule {
  description String @default("") @db.VarChar(500)
  rules Json?
  allocations Json?
  isTemplate Boolean @default(false) @map("is_template")
  accounts Account[]
  id             String            @id
  name           String
  fundAccountId  String?           @map("fund_account_id")
  payeeId        String?           @map("payee_id")
  mode           String            @default("AUTO")
  triggerBalance Decimal           @map("trigger_balance") @db.Decimal(20, 2)
  reserveAmount  Decimal           @default(0) @map("reserve_amount") @db.Decimal(20, 2)
  feeBuffer      Decimal           @default(0) @map("fee_buffer") @db.Decimal(20, 2)
  minAmount      Decimal           @default(0) @map("min_amount") @db.Decimal(20, 2)
  maxAmount      Decimal           @map("max_amount") @db.Decimal(20, 2)
  dailyLimit     Decimal?          @map("daily_limit") @db.Decimal(20, 2)
  enabled        Boolean           @default(false)
  version        Int               @default(1)
  createdBy      String            @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedBy      String?           @map("updated_by")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  // 软删除：转账单对策略有外键保护，历史转账记录要继续显示策略名，所以只打删除时间，不真删行
  deletedAt      DateTime?         @map("deleted_at")
  fundAccount    FundAccount?      @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)
  payee          Payee?            @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  requests       TransferRequest[]

  @@index([fundAccountId, enabled])
  @@map("transfer_rule")
}

// 转账单：金额、收款人、规则版本在生成时固定。
// PREPARING 已领取未授权 / CLAIMED 已授权提交或历史执行中 / UNKNOWN 须核实；只有 PREPARING 可自动退回 READY。
model TransferRequest {
  accountId String? @map("account_id")
  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  batchId String? @map("batch_id")
  sessionId String? @map("session_id")
  reserveSnapshot Decimal @default(0) @map("reserve_snapshot") @db.Decimal(20, 2)
  id              String       @id
  outBizNo        String       @unique @map("out_biz_no")
  // TEST（手动转账测试）单不属于任何策略，也不关联收款人库
  ruleId          String?      @map("rule_id")
  ruleVersion     Int?         @map("rule_version")
  fundAccountId   String?      @map("fund_account_id")
  payeeId         String?      @map("payee_id")
  // 转账测试单自带的收款信息：账号加密存放，姓名和备注明文（备注最多 20 字）
  testPayeeName             String? @map("test_payee_name") @db.VarChar(100)
  testPayeeAccountEncrypted String? @map("test_payee_account_encrypted") @db.Text
  testRemark                String? @map("test_remark") @db.VarChar(20)
  // 采集端最近一次进度上报（3 秒心跳），用于判断脚本是否卡住；完整日志按时间追加在 progressLogs 里
  progressAt      DateTime?    @map("progress_at")
  progressNote    String?      @map("progress_note") @db.VarChar(200)
  progressLogs    Json?        @map("progress_logs")
  amount          Decimal      @db.Decimal(20, 2)
  balanceSnapshot Decimal      @map("balance_snapshot") @db.Decimal(20, 2)
  balanceAt       DateTime     @map("balance_at")
  mode            String
  status          String
  collectorId     String?      @map("collector_id")
  claimedAt       DateTime?    @map("claimed_at")
  completedAt     DateTime?    @map("completed_at")
  resultNote      String?      @map("result_note") @db.VarChar(500)
  // 终态截图的采集时间；图片本体放在 TransferScreenshot，列表查询不会带出
  screenshotAt    DateTime?    @map("screenshot_at")
  // 失败原因代码：目前只有 QR_TIMEOUT（扫码确认超时），用于作废同批次后续分笔
  failureCode     String?      @map("failure_code") @db.VarChar(32)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  rule            TransferRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  fundAccount     FundAccount? @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)
  payee           Payee?       @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  screenshot      TransferScreenshot?

  @@index([accountId, status])
  @@index([batchId])
  @@index([fundAccountId, status])
  @@index([status, createdAt])
  @@map("transfer_request")
}

// 转账终态截图：一单一图（JPEG data URL），永久保留；单独成表，避免大字段拖慢转账单的列表和领单查询。
model TransferScreenshot {
  transferId String          @id @map("transfer_id")
  image      String          @db.MediumText
  // 采集端截图时判断的结局（SUCCEEDED / FAILED / UNKNOWN），仅用于展示
  result     String          @db.VarChar(16)
  createdAt  DateTime        @default(now()) @map("created_at")
  transfer   TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("transfer_screenshot")
}

// 指令及巡检结果持久化，不保存明文凭据。
model CollectorCommand {
  id                  String    @id @db.VarChar(64)
  collectorId         String    @map("collector_id")
  accountId           String?   @map("account_id")
  kind                String    @db.VarChar(32)
  status              String    @default("PENDING") @db.VarChar(20)
