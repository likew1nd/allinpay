// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model SysTokens {
  id           String   @id @default(cuid())
  accessToken  String   @unique @map("access_token") @db.VarChar(2048)
  refreshToken String   @unique @map("refresh_token") @db.VarChar(2048)
  status       String
  userId       String   @map("user_id")
  username     String
  domain       String
  loginTime    DateTime @default(now()) @map("login_time")
  ip           String
  port         Int?
  address      String
  userAgent    String   @map("user_agent")
  requestId    String   @map("request_id")
  type         String
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String   @map("created_by")

  @@map("sys_tokens")
}

// 用户表
model SysUser {
  id          String    @id
  username    String    @unique
  password    String
  domain      String
  built_in    Boolean   @default(false)
  avatar      String?
  email       String?   @unique
  phoneNumber String?   @unique @map("phone_number")
  nickName    String    @map("nick_name")
  status      Status
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  @@map("sys_user")
}

enum Status {
  ENABLED
  DISABLED
  BANNED
}

// casbin_rule
model CasbinRule {
  id    Int     @id @default(autoincrement())
  ptype String
  v0    String?
  v1    String?
  v2    String?
  v3    String?
  v4    String?
  v5    String?

  @@map("casbin_rule")
}

// domain 租户/域
model SysDomain {
  id          String    @id
  code        String    @unique
  name        String
  description String?
  status      Status
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  @@map("sys_domain")
}

// 角色表
model SysRole {
  id          String    @id
  code        String    @unique
  name        String
  description String?
  pid         String    @default("0")
  status      Status
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  @@map("sys_role")
}

model SysUserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  @@id([userId, roleId])
  @@map("sys_user_role")
}

// 接口资源表
model SysEndpoint {
  id         String    @id
  path       String
  method     String
  action     String
  resource   String
  controller String
  summary    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("sys_endpoint")
}

// 组织机构
model SysOrganization {
  id          String    @id
  code        String    @unique
  name        String
  description String?
  pid         String    @default("0")
  status      Status
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String    @map("created_by")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")

  @@map("sys_organization")
}

model SysLoginLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  username  String
  domain    String
  loginTime DateTime @default(now()) @map("login_time")
  ip        String
  port      Int?
  address   String
  userAgent String   @map("user_agent")
  requestId String   @map("request_id")
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  @@map("sys_login_log")
}

model SysOperationLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  username    String
  domain      String
  moduleName  String   @map("module_name")
  description String
  requestId   String   @map("request_id")
  method      String
  url         String
  ip          String
  userAgent   String?  @map("user_agent")
  params      Json?    @map("params")
  body        Json?    @map("body")
  response    Json?    @map("response")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  duration    Int
  createdAt   DateTime @default(now()) @map("created_at")

  source     String  @default("USER")
  level      String  @default("INFO")
  status     String  @default("UNKNOWN")
  objectId   String? @map("object_id")
  objectName String? @map("object_name") @db.VarChar(500)
  relatedId  String? @map("related_id")

  @@index([domain, endTime, id])
  @@index([domain, source, level, endTime])
  @@map("sys_operation_log")
}

enum MenuType {
  directory
  menu
}

model SysMenu {
  id        Int      @id @default(autoincrement())
  menuType  MenuType @map("menu_type")
  menuName  String   @map("menu_name") @db.VarChar(64)
  iconType  Int?     @default(1) @map("icon_type")
  icon      String?  @map("icon") @db.VarChar(64)
  routeName String   @unique @map("route_name") @db.VarChar(64)
  routePath String   @map("route_path") @db.VarChar(128)
  component String   @map("component") @db.VarChar(64)
  pathParam String?  @map("path_param") @db.VarChar(64)
  status    Status

  activeMenu String?  @map("active_menu") @db.VarChar(64)
  hideInMenu Boolean? @default(false) @map("hide_in_menu")
  pid        Int      @default(0)
  order      Int      @map("sequence")
  i18nKey    String?  @map("i18n_key") @db.VarChar(64)
  keepAlive  Boolean? @default(false) @map("keep_alive")
  constant   Boolean  @default(false)
  href       String?  @map("href") @db.VarChar(64)
  multiTab   Boolean? @default(false) @map("multi_tab")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  @@map("sys_menu")
}

model SysRoleMenu {
  roleId String @map("role_id")
  menuId Int    @map("menu_id")
  domain String

  @@id([roleId, menuId, domain])
  @@map("sys_role_menu")
}

model SysAccessKey {
  id              String   @id @default(cuid())
  domain          String
  AccessKeyID     String   @unique @map("access_key_id")
  AccessKeySecret String   @unique @map("access_key_secret")
  status          Status
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String   @map("created_by")

  @@map("sys_access_key")
}

enum SiteConnectionStatus {
  PENDING
  ONLINE
  OFFLINE
  ERROR
}

enum SiteStructureStatus {
  UNKNOWN
  COMPATIBLE
  INCOMPATIBLE
}

enum SiteChannelStatus {
  ENABLED
  DISABLED
  UNKNOWN
}

enum SiteOrderStatus {
  SUCCESS
  FAILED
  PROCESSING
  EXCLUDED
}

enum StrategyStatus {
  DRAFT
  RUNNING
  PAUSED
  ERROR
}

enum CollectorStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum AccountStatus {
  HEALTHY
  DEGRADED
  AUTH_EXPIRED
  PASSWORD_REJECTED
  CAPTCHA_REQUIRED
  ENV_UNAVAILABLE
  UNKNOWN
}

enum AccountBusinessStatus {
  NORMAL
  RESTRICTED
  JUDICIAL
  UNKNOWN
}

model EpaySite {
  id                    String                 @id
  name                  String
  baseUrl               String                 @map("base_url")
  tablePrefix           String?                @map("table_prefix")
  timezone              String                 @default("Asia/Shanghai")
  dbHost                String                 @map("db_host")
  dbPort                Int                    @default(3306) @map("db_port")
  dbName                String                 @map("db_name")
  dbUser                String                 @map("db_user")
  credentialRef         String                 @map("credential_ref")
  dbPasswordEncrypted   String?                @map("db_password_encrypted")
  agentTokenEncrypted   String?                @map("agent_token_encrypted")
  connectionStatus      SiteConnectionStatus   @default(PENDING) @map("connection_status")
  structureStatus       SiteStructureStatus    @default(UNKNOWN) @map("structure_status")
  structureReport       Json?                  @map("structure_report")
  adapterVersion        String?                @map("adapter_version")
  agentVersion          String?                @map("agent_version")
  lastHeartbeatAt       DateTime?              @map("last_heartbeat_at")
  syncRevision          Int                    @default(1) @map("sync_revision")
  nextConnectionAt      DateTime               @default(now()) @map("next_connection_at")
  connectionLeaseUntil  DateTime?              @map("connection_lease_until")
  connectionLeaseOwner  String?                @map("connection_lease_owner")
  activeSyncId          String?                @map("active_sync_id")
  syncRuns              EpaySyncRun[]
  lastSyncAt            DateTime?              @map("last_sync_at")
  automationPaused      Boolean                @default(false) @map("automation_paused")
  lastError             String?                @map("last_error")
  createdAt             DateTime               @default(now()) @map("created_at")
  createdBy             String                 @map("created_by")
  updatedAt             DateTime?              @updatedAt @map("updated_at")
  updatedBy             String?                @map("updated_by")
  channels              EpayChannel[]
  pollingGroups         EpayPollingGroup[]
  orders                EpayOrder[]
  metrics               EpaySiteMetric[]
  strategyGroups        StrategyGroup[]
  adjustmentRecords     AdjustmentRecord[]
  accountBindings       AccountBinding[]
  strategyGroupBindings StrategyGroupBinding[]
  strategyTargets       StrategyTarget[]
  manualTakeovers       ManualTakeover[]

  @@index([connectionStatus])
  @@index([nextConnectionAt, connectionLeaseUntil])
  @@map("epay_site")
}

model Collector {
  apiEndpoint              String?                  @map("api_endpoint") @db.VarChar(300)
  apiKeyEncrypted          String?                  @map("api_key_encrypted") @db.Text
  nextSyncAt               DateTime                 @default(now()) @map("next_sync_at")
  syncLeaseUntil           DateTime?                @map("sync_lease_until")
  syncLeaseOwner           String?                  @map("sync_lease_owner")
  configRevision           Int                      @default(1) @map("config_revision")
  scriptNextAt             DateTime                 @default(now()) @map("script_next_at")
  scriptLeaseUntil         DateTime?                @map("script_lease_until")
  scriptLeaseOwner         String?                  @map("script_lease_owner")
  id                       String                   @id
  name                     String
  tokenEncrypted           String?                  @map("token_encrypted")
  status                   CollectorStatus          @default(OFFLINE)
  version                  String?
  lastHeartbeatAt          DateTime?                @map("last_heartbeat_at")
  lastError                String?                  @map("last_error")
  metadata                 Json?
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime?                @updatedAt @map("updated_at")
  accounts                 Account[]
  agentSessionId           String?                  @map("agent_session_id") @db.VarChar(64)
  agentSessionStartedAt    DateTime?                @map("agent_session_started_at")
  appliedRevision          Int                      @default(0) @map("applied_revision")
  adsPowerStatus           String                   @default("UNKNOWN") @map("ads_power_status") @db.VarChar(20)
  adsPowerCheckedAt        DateTime?                @map("ads_power_checked_at")
  environmentSyncedAt      DateTime?                @map("environment_synced_at")
  environmentSyncError     String?                  @map("environment_sync_error") @db.VarChar(500)
  monitoringEnabled        Boolean                  @default(true) @map("monitoring_enabled")
  inventorySyncId         String?                  @map("inventory_sync_id") @db.VarChar(64)
  inventoryLastCompletedId String?                  @map("inventory_last_completed_id") @db.VarChar(64)
  commands                 CollectorCommand[]
  inventoryPages           CollectorInventoryPage[]

  @@index([status, lastHeartbeatAt])
  @@map("collector")
}

// AdsPower 页面巡检的全局配置。账号/环境归属仍在 Collector/Account，
// 保存共同脚本参数与加密的平台密码，不保存 Cookie 或页面全文。
model ScriptSetting {
  id                       String   @id
  enabled                  Boolean  @default(false)
  tab1Url                  String   @map("tab1_url") @db.VarChar(500)
  tab2Url                  String   @map("tab2_url") @db.VarChar(500)
  tab3Url                  String   @default("https://open.alipay.com/develop/manage") @map("tab3_url") @db.VarChar(500)
  minRefreshSeconds        Int      @default(45) @map("min_refresh_seconds")
  maxRefreshSeconds        Int      @default(90) @map("max_refresh_seconds")
  navigationTimeoutSeconds Int      @default(30) @map("navigation_timeout_seconds")
  maxConcurrentAccounts    Int      @default(4) @map("max_concurrent_accounts")
  retryCount               Int      @default(2) @map("retry_count")
  actionTimeoutSeconds     Int      @default(15) @map("action_timeout_seconds")
  loginCooldownMinutes     Int      @default(10) @map("login_cooldown_minutes")
  loginMaxAttempts         Int      @default(3) @map("login_max_attempts")
  loginTimeoutMinutes      Int      @default(3) @map("login_timeout_minutes")
  // 环境同步间隔（分钟）：采集端按此周期把 AdsPower 环境清单同步到中心；手动“同步环境”不受影响
  environmentSyncMinutes   Int      @default(30) @map("environment_sync_minutes")
  // 余额新鲜阈值（分钟）：转账只使用此时间内采集到的余额，超过则先刷新余额；默认 10
  balanceFreshMinutes      Int      @default(10) @map("balance_fresh_minutes")
  // 扫码确认：二维码发出后最多等待的分钟数，超时本笔转账按失败结束
  qrWaitMinutes            Int      @default(8) @map("qr_wait_minutes")
  closeRestrictedChannels Boolean  @default(false) @map("close_restricted_channels")
  restoreRecoveredChannels Boolean @default(false) @map("restore_recovered_channels")
  // 滑块识别坐标的固定补偿像素；负值表示回退。默认 +10，修正"少滑一点"的偏差。
  sliderOffsetPx              Int      @default(10) @map("slider_offset_px")
  captchaProvider             String   @default("NONE") @map("captcha_provider") @db.VarChar(32)
  // 图鉴打码平台凭据
  ttshituUsername             String   @default("") @map("ttshitu_username") @db.VarChar(191)
  ttshituPasswordEncrypted    String?  @map("ttshitu_password_encrypted") @db.Text
  // 滨图打码平台凭据
  bingtopUsername             String   @default("") @map("bingtop_username") @db.VarChar(191)
  bingtopPasswordEncrypted    String?  @map("bingtop_password_encrypted") @db.Text
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")
  updatedBy                   String?  @map("updated_by") @db.VarChar(191)

  @@map("script_setting")
}

model Account {
  // 列表归属与执行开关独立，暂停转账不移出列表。
  transferListed Boolean @default(false) @map("transfer_listed")
  transferEnabled Boolean @default(false) @map("transfer_enabled")
  transferRuleId String? @map("transfer_rule_id")
  transferRule TransferRule? @relation(fields: [transferRuleId], references: [id], onDelete: SetNull)
  transfers TransferRequest[]
  transferRefreshRequired Boolean @default(false) @map("transfer_refresh_required")
  profileNo             String?               @map("profile_no")
  groupName             String?               @map("group_name")
  profilePresent        Boolean               @default(true) @map("profile_present")
  businessStatus        AccountBusinessStatus @default(UNKNOWN) @map("business_status")
  receiptLimit          Decimal?              @map("receipt_limit") @db.Decimal(20, 2)
  paymentLimit          Decimal?              @map("payment_limit") @db.Decimal(20, 2)
  unavailableBalance    Decimal?              @map("unavailable_balance") @db.Decimal(20, 2)
  pendingBalance        Decimal?              @map("pending_balance") @db.Decimal(20, 2)
  // 登录后巡检截图（JPEG data URL）：命中限制/司法时保存，解除后清空；列表接口不返回图片本身，只返回采集时间
  restrictionImage      String?               @map("restriction_image") @db.MediumText
  restrictionImageAt    DateTime?             @map("restriction_image_at")
  judicialImage         String?               @map("judicial_image") @db.MediumText
  judicialImageAt       DateTime?             @map("judicial_image_at")
  // 登录后巡检得到的限制标记：两项可同时为真；businessStatus 是兼容用的单值（司法优先）
  restrictionActive     Boolean               @default(false) @map("restriction_active")
  judicialActive        Boolean               @default(false) @map("judicial_active")
  restrictionObservedAt DateTime?             @map("restriction_observed_at")
  restrictionClearedAt  DateTime?             @map("restriction_cleared_at")
  // 页面上收款/付款额度显示为“不限额”时为 true，此时对应的额度数值字段无意义
  receiptUnlimited      Boolean               @default(false) @map("receipt_unlimited")
  paymentUnlimited      Boolean               @default(false) @map("payment_unlimited")
  id                    String                @id
  collectorId           String?               @map("collector_id")
  externalId            String                @map("external_id")
  name                  String?
  status                AccountStatus         @default(UNKNOWN)
  browserState          String?               @map("browser_state")
  lastSeenAt            DateTime?             @map("last_seen_at")
  lastError             String?               @map("last_error")
  scriptNextAt          DateTime              @default(now()) @map("script_next_at")
  scriptLeaseUntil      DateTime?             @map("script_lease_until")
  scriptLeaseOwner      String?               @map("script_lease_owner")
  // 是否启用监控：默认关闭，新增采集端同步进来的环境不自动监控，需手动或批量开启
  monitoringEnabled     Boolean               @default(false) @map("monitoring_enabled")
  appIdsRefreshRequestedAt DateTime?           @map("app_ids_refresh_requested_at")
  monitoringLogs        Json?                 @map("monitoring_logs")
  monitoringTabBindings Json?                 @map("monitoring_tab_bindings")
  metadata              Json?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime?             @updatedAt @map("updated_at")
  collector             Collector?            @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  bindings              AccountBinding[]
  fundAccount           FundAccount?
  credentials           AccountCredentials?
  // 页面采集到的余额，由采集端心跳上报；超过 5 分钟没更新就不用于触发转账
  balance               Decimal?              @db.Decimal(20, 2)
  balanceAt             DateTime?             @map("balance_at")

  @@unique([collectorId, externalId])
  @@index([status, lastSeenAt])
  @@map("account")
}

model AccountCredentials {
  accountId           String    @id @map("account_id")
  loginAccount        String    @default("") @map("login_account") @db.VarChar(191)
  appId               String    @default("") @map("app_id") @db.VarChar(191)
  appIds              Json?     @map("app_ids")
  passwordEncrypted   String?   @map("password_encrypted") @db.Text
  paymentPasswordEncrypted String? @map("payment_password_encrypted") @db.Text
  loginAttemptAfter   DateTime? @map("login_attempt_after")
  loginAttempts       Int       @default(0) @map("login_attempts")
  loginBlocked        Boolean   @default(false) @map("login_blocked")
  captchaImageHash    String?   @map("captcha_image_hash") @db.VarChar(64)
  captchaAttemptAfter DateTime? @map("captcha_attempt_after")
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_credentials")
}

model AccountBinding {
  id          String    @id
  accountId   String    @map("account_id")
  siteId      String    @map("site_id")
  channelCode String    @map("channel_code")
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  site        EpaySite  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([accountId, siteId, channelCode])
  @@index([siteId, channelCode, enabled])
  @@map("account_binding")
}

model FundAccount {
  id               String             @id
  name             String
  owner            String
  balance          Decimal            @default(0) @db.Decimal(20, 2)
  frozen           Decimal            @default(0) @db.Decimal(20, 2)
  status           String             @default("ACTIVE")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  settlements      SettlementRecord[]
  // 由哪个采集端账号付款并上报余额，可空
  accountId        String?            @unique @map("account_id")
  account          Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transferRules    TransferRule[]
  transferRequests TransferRequest[]

  @@map("fund_account")
}


model SettlementRecord {
  id            String      @id
  fundAccountId String      @map("fund_account_id")
  periodStart   DateTime    @map("period_start")
  periodEnd     DateTime    @map("period_end")
  amount        Decimal     @db.Decimal(20, 2)
  fee           Decimal     @default(0) @db.Decimal(20, 2)
  status        String      @default("PENDING")
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  fundAccount   FundAccount @relation(fields: [fundAccountId], references: [id], onDelete: Restrict)

  @@index([status, periodEnd])
  @@map("settlement_record")
}

model EpayChannel {
  details        Json?
  id             String              @id
  siteId         String              @map("site_id")
  code           String
  name           String
  channelType    String?             @map("channel_type")
  status         SiteChannelStatus   @default(UNKNOWN)
  plugin         String?
  paymentTypeId  String?             @map("payment_type_id")
  sourceStatus   Int                 @default(0) @map("source_status")
  dayStatus      Int                 @default(0) @map("day_status")
  currentWeight  Int                 @default(0) @map("current_weight")
  sourceVersion  String?             @map("source_version")
  updatedAt      DateTime?           @updatedAt @map("updated_at")
  site           EpaySite            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pollingMembers EpayPollingMember[]

  @@unique([siteId, code])
  @@index([siteId, status])
  @@map("epay_channel")
}

model EpayPollingGroup {
  kind            Int                 @default(0)
  position        Int                 @default(0)
  paymentTypeId   String?             @map("payment_type_id")
  paymentTypeName String?             @map("payment_type_name")
  updatedAt       DateTime?           @map("updated_at")
  id              String              @id
  siteId          String              @map("site_id")
  code            String
  name            String
  status          SiteChannelStatus   @default(UNKNOWN)
  sourceVersion   String?             @map("source_version")
  site            EpaySite            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  members         EpayPollingMember[]

  @@unique([siteId, code])
  @@map("epay_polling_group")
}

model EpayPollingMember {
  groupId      String           @map("group_id")
  channelId    String           @map("channel_id")
  position     Int              @default(0)
  weight       Int              @default(0)
  enabled      Boolean          @default(true)
  pollingGroup EpayPollingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel      EpayChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([groupId, channelId])
  @@map("epay_polling_member")
}

model EpayOrder {
  syncRunId       String?         @map("sync_run_id")
  syncRun         EpaySyncRun?    @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  merchantId      String?         @map("merchant_id")
  paymentTypeId   String?         @map("payment_type_id")
  paymentTypeName String?         @map("payment_type_name")
  subchannelCode  String?         @map("subchannel_code")
  realAmount      Decimal?        @map("real_amount") @db.Decimal(18, 2)
