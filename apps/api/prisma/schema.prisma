  state         String
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([accountId, state])
  @@map("restriction_channel_hold")
}

model RestrictionChannelJob {
  id          String   @id
  accountId   String   @map("account_id")
  action      String
  source      String
  eventTypes  Json     @map("event_types")
  evidence    Json?
  results     Json?
  notifiedResults Json? @map("notified_results")
  nextAt      DateTime @default(now()) @map("next_at")
  completedAt DateTime? @map("completed_at")
  leaseUntil  DateTime? @map("lease_until")
  leaseOwner  String?  @map("lease_owner")
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([completedAt, nextAt])
  @@map("restriction_channel_job")
}

model TelegramDelivery {
  transferRequestId String?
  id                 String   @id
  botId              String
  epoch              Int
  eventId            String?
  incidentId         String?
  commandExecutionId String?
  dedupeKey          String   @unique @db.VarChar(64)
  targetId           String?
  chatId             String
  threadKey          Int      @default(0)
  kind               String
  text               String   @db.LongText
  buttons            Json?
  // 转账二维码等图片消息：JPEG data URL，发送成功或作废后清空
  image              String?  @db.MediumText
  status             String   @default("PENDING")
  attempts           Int      @default(0)
  nextAttemptAt      DateTime @default(now())
  leaseOwner         String?
  leaseUntil         DateTime?
  messageId          Int?
  error              String?  @db.VarChar(500)
  createdAt          DateTime @default(now())
  sentAt             DateTime?
  @@index([botId, status, nextAttemptAt])
  @@index([targetId, createdAt])
  @@index([incidentId, targetId])
  @@map("telegram_delivery")
}

model TelegramIncidentPreference {
  id          String   @id
  incidentId  String
  targetId    String
  mutedUntil  DateTime
  updatedBy   String
  @@unique([incidentId, targetId])
  @@map("telegram_incident_preference")
}
