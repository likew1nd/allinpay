{
  "name": "@sa/elp",
  "type": "module",
  "version": "1.4.0",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.7.0"
  },
  "scripts": {
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "gen-route": "sa gen-route",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "preview": "vite preview",
    "release": "sa release",
    "check:tables": "node scripts/table-policy-check.cjs && node scripts/table-race-check.cjs && node scripts/table-refresh-check.cjs",
    "check:business": "node scripts/environment-batch-check.cjs && node scripts/environment-list-check.cjs && node scripts/collector-update-check.cjs && node scripts/permission-label-check.cjs && node scripts/telegram-command-check.cjs && node scripts/theme-settings-check.cjs && node scripts/transfer-strategy-check.cjs",
    "typecheck": "node scripts/table-policy-check.cjs && vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.0",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@vueuse/components": "14.2.1",
    "@vueuse/core": "14.2.1",
    "dayjs": "1.11.20",
    "defu": "^6.1.4",
    "echarts": "6.0.0",
    "element-plus": "^2.13.6",
    "json5": "2.2.3",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "tailwind-merge": "3.5.0",
    "vue": "3.5.31",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.3.0",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.458",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config": "1.7.5",
    "@types/node": "25.5.0",
    "@types/nprogress": "0.2.3",
    "@unocss/eslint-config": "66.6.7",
    "@unocss/preset-icons": "66.6.7",
    "@unocss/preset-uno": "66.6.7",
    "@unocss/transformer-directives": "66.6.7",
    "@unocss/transformer-variant-group": "66.6.7",
    "@unocss/vite": "66.6.7",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "consola": "3.4.2",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.6.2",
    "kolorist": "1.8.0",
    "sass": "1.98.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-svg-icons": "2.0.1",
    "vite-plugin-vue-devtools": "8.1.1",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.6"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm sa git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint && git diff --exit-code"
  }
}
